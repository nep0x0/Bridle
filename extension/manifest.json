{
  "manifest_version": 3,
  "name": "bridle bridge",
  "version": "0.1.0",
  "description": "Bridle's web-chat render adapter: turns a normal AI chat tab into the reasoning engine of a local bridle harness.",
  "license": "GPL-3.0-or-later",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["ws://127.0.0.1/*", "ws://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*", "https://deepseek.com/*"],
      "js": ["content/bridle-wire.js", "content/deepseek.js"],
      "run_at": "document_idle"
    }
  ]
}
