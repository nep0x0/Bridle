{
  "name": "@bridle/workflow",
  "version": "0.1.0",
  "description": "bridle workflow pack: plan manifest, verify-driven auto_run, scaffolds — enforcement over hope",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bridle/kernel": "workspace:*",
    "@bridle/session": "workspace:*",
    "@bridle/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
